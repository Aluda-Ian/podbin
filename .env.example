# PodBin Environment Configuration
# Copy this to .env and fill in your values

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
POSTGRES_USER=podbin
POSTGRES_PASSWORD=podbin_secure_pass
POSTGRES_DB=podbin

# For local dev with SQLite, leave DATABASE_URL empty (will auto-use SQLite)
# For production PostgreSQL, set this:
# DATABASE_URL=postgresql+asyncpg://podbin:podbin_secure_pass@localhost:5432/podbin

# ─── Security ───────────────────────────────────────────────────────────────
ENCRYPTION_SALT=change_this_to_a_random_secret_string

# ─── AI Provider Keys ───────────────────────────────────────────────────────
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# ─── Social Platform OAuth Credentials ─────────────────────────────────────
# Facebook / Instagram Graph API
# Get these from: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Twitter / X API v2
# Get these from: https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# YouTube Data API v3 (Google OAuth)
# Get these from: https://console.cloud.google.com/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# TikTok for Developers
# Get these from: https://developers.tiktok.com/
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# LinkedIn
# Get these from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
