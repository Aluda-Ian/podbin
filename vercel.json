{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/logos/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|health|static/|logos/).*)",
      "destination": "/index.html"
    }
  ]
}