{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/redoc",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/logos/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|health|docs|redoc|openapi.json|static/|logos/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}